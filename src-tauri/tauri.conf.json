{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WireMaster",
  "version": "0.1.0",
  "identifier": "dev.wiremaster.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WireMaster",
        "width": 1500,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 650
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all" }
}
